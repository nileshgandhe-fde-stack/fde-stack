[0m16:22:42.149449 [debug] [Thread-2 (]: On model.day10_warehouse_modelling.stg_enterprise_claims: /* {"app": "dbt", "dbt_version": "1.8.10", "profile_name": "day10_warehouse_modelling", "target_name": "dev", "node_id": "model.day10_warehouse_modelling.stg_enterprise_claims"} */

  
  create view "fde_warehouse"."main"."stg_enterprise_claims__dbt_tmp" as (
    

WITH raw_source AS (
    SELECT * FROM "fde_warehouse"."main"."raw_claims"
),

deduplicated AS (
    SELECT
        UPPER(TRIM(claim_id)) AS claim_id,
        LOWER(TRIM(tenant_id)) AS tenant_id,
        CAST(amount_usd AS NUMERIC(12, 2)) AS amount_usd,
        UPPER(TRIM(status)) AS claim_status,
        CAST(updated_at AS TIMESTAMP) AS updated_at,
        ROW_NUMBER() OVER (
            PARTITION BY UPPER(TRIM(claim_id))
            ORDER BY CAST(updated_at AS TIMESTAMP) DESC
        ) AS rn
    FROM raw_source
    WHERE amount_usd > 0 AND claim_id IS NOT NULL
)

SELECT
    claim_id,
    tenant_id,
    amount_usd,
    claim_status,
    updated_at
FROM deduplicated
WHERE rn = 1
  );

